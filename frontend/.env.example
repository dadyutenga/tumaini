# Copy to .env.local to customize locally.
# NOTE: All VITE_* variables are exposed to the browser bundle. Never store secrets here.

# Leave blank in development: the Vite dev server proxies /api to the Go API at
# http://127.0.0.1:8080 (override with API_PROXY_TARGET), so the refresh cookie stays same-origin.
# Set it only when the API is served from another origin, for example https://api.example.com.
VITE_API_BASE_URL=
