{
  "name": "OpenDashboards",
  "source": {
    "dashboard": "@openuidev/dashboard-library defaultLightTheme / defaultDarkTheme",
    "app": "app/globals.css",
    "marketing": "components/landing/bevel-button.tsx and app/(marketing)/layout.tsx"
  },
  "font": {
    "sans": "Inter",
    "display": "Inter Display",
    "wordmark": "Geist",
    "mono": "Geist Mono"
  },
  "type": {
    "page": { "size": "1.75rem", "weight": 700, "leading": 1.2, "tracking": "-0.02em" },
    "section": { "size": "15px", "weight": 600, "tracking": "-0.005em" },
    "card": { "size": "14px", "weight": 600, "leading": 1.35 },
    "kpi": { "size": "26px", "weight": 600, "leading": 1.1 },
    "body": { "size": "13px", "weight": 500, "leading": 1.45 },
    "caption": { "size": "12px", "leading": 1.4 },
    "display": { "size": "clamp(1.75rem, 3vw, 2.5rem)", "weight": 600, "leading": 1.1, "tracking": "-0.02em" }
  },
  "dashboard": {
    "light": {
      "page": "#eeece6",
      "surface": "#f7f5f0",
      "surfaceSubtle": "#e6e3db",
      "border": "#dad6cc",
      "borderStrong": "#cfcbc0",
      "inputBorder": "#c5c1b5",
      "ink": "#2a2d33",
      "inkSecondary": "#4a4f57",
      "inkMuted": "#585d66",
      "grid": "#dedad0",
      "accent": "#343c4a",
      "accentInk": "#f7f5f0",
      "link": "#2f5f9e",
      "series": ["#5a52c4", "#2e7d57", "#c7932a", "#b84b6a", "#2f5f9e", "#c76d2b", "#8c5236", "#248a94"],
      "sequential": ["#ececf5", "#d6daf0", "#bfc5e8", "#a7afdf", "#909ad6", "#7983cb", "#636dbe", "#4f57ae", "#3f4098"],
      "diverging": ["#a43b5a", "#b9647a", "#ce8f9d", "#e2bcc4", "#e6e3db", "#c2c8e6", "#9da6da", "#7883cc", "#5660ba"],
      "good": "#236b48",
      "goodMark": "#2e7d57",
      "bad": "#a4353c",
      "badMark": "#b5434a",
      "warning": "#85570d",
      "warningMark": "#d9a743",
      "info": "#2f5f9e",
      "mapLand": "#e6e3db",
      "radius": "16px",
      "radiusMd": "12px",
      "radiusSm": "8px",
      "space": ["8px", "12px", "16px", "20px", "24px", "36px"],
      "shadow": "0 1px 2px rgb(40 35 25 / 0.06)"
    },
    "dark": {
      "page": "#141414",
      "surface": "#151515",
      "ink": "#fafafa",
      "series": ["#7b72f2", "#16b76f", "#ffc700", "#df507b", "#3894ff", "#ff8000", "#b8693a", "#00cbd9"],
      "good": "#7fe0b1",
      "bad": "#f1838c",
      "warning": "#ffd84d",
      "info": "#8fbcf7",
      "mapLand": "#232323"
    }
  },
  "app": {
    "radius": "0.625rem",
    "light": {
      "background": "#eeece6",
      "foreground": "#2a2d33",
      "card": "#f7f5f0",
      "primary": "#343c4a",
      "primaryForeground": "#f7f5f0",
      "muted": "#e6e3db",
      "mutedForeground": "#585d66",
      "border": "#cfcbc0",
      "input": "#c5c1b5",
      "ring": "#2f5f9e",
      "destructive": "#a4353c",
      "chart": ["#9f9b90", "#76746c", "#5d5c57", "#474a50", "#343c4a"]
    }
  },
  "marketing": {
    "page": "#eeece6",
    "ink": "#2a2d33",
    "muted": "#585d66",
    "secondary": "#e6e3db",
    "buttonHeight": "48px",
    "buttonRadius": "999px"
  }
}
