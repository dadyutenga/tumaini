# Application
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# The API connects as bms_app. Migrations connect as bms_owner.
DATABASE_URL=postgres://bms_app:bms_app_dev@127.0.0.1:5433/bms?sslmode=disable
MIGRATE_DATABASE_URL=postgres://bms_owner:bms_owner_dev@127.0.0.1:5433/bms?sslmode=disable

# At least 32 characters. Generate a new value for any shared environment.
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

CORS_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false

STORAGE_DRIVER=local
STORAGE_PATH=./data/files

# Argon2id. Production should use memory 65536 and time 3.
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1
