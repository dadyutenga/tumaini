# Application
# APP_ENV=production turns on extra checks: COOKIE_SECURE must be true, CORS_ORIGINS cannot be *,
# and JWT_SECRET cannot be the example value.
APP_ENV=development
HTTP_ADDR=:8080
# debug, info, warn or error
LOG_LEVEL=info

# The API connects as bms_api (member of bms_app: no schema rights, row-level security always applies).
# Migrations connect as bms_owner. Create both with deploy/postgres/init.sql.
DATABASE_URL=postgres://bms_api:bms_api_dev@127.0.0.1:5433/bms?sslmode=disable
# Worker role (bms_jobs): tenant provisioning and background jobs only.
JOBS_DATABASE_URL=postgres://bms_jobs:bms_jobs_dev@127.0.0.1:5433/bms?sslmode=disable
MIGRATE_DATABASE_URL=postgres://bms_owner:bms_owner_dev@127.0.0.1:5433/bms?sslmode=disable
# A session unused for this long is ended (spec: 30 minutes).
SESSION_IDLE_TIMEOUT=30m
# How long a recent password/MFA verification remains valid for sensitive account changes.
REAUTH_TTL=10m

# At least 32 characters. Generate a new value for any shared environment, for example:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
# Optional 32+ char key for envelope-encrypting TOTP MFA seeds (defaults to a key derived from JWT_SECRET).
MFA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Comma-separated browser origins that may call the API with credentials.
CORS_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
# Must be true behind HTTPS (required when APP_ENV=production).
COOKIE_SECURE=false

# Reverse proxies whose X-Forwarded-For header is trusted (IPs or CIDRs, comma-separated).
# Leave empty when the API is reached directly. Set it behind nginx or a load balancer, otherwise
# every user shares the proxy's address in rate limits and audit logs, for example: 10.0.0.0/8
TRUSTED_PROXIES=

# Files are kept on local disk. Mount STORAGE_PATH on a persistent volume.
STORAGE_DRIVER=local
STORAGE_PATH=./data/files

# Given to every new business.
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
DEFAULT_CURRENCY=TZS

# Argon2id. Production should use memory 65536 and time 3.
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1

# Optional: email (SMTP with STARTTLS, or implicit TLS on port 465). Used for password recovery
# by email and for notification types the Owner switches on under Settings > Notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: SMS through an HTTPS gateway that accepts POST {"to","from","message"} with a bearer key
# (or a small adapter in front of your provider). Used for password recovery by phone and for
# notification types switched on for SMS.
SMS_WEBHOOK_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Optional: scan uploads with ClamAV (clamd host:port). When set, an unreachable scanner refuses uploads.
# CLAMD_ADDR=127.0.0.1:3310
