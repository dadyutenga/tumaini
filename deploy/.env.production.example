# Server-side configuration for the production stack. scripts/server-setup.sh creates /opt/tumaini/.env
# from this file with generated secrets; it never overwrites an existing .env.

# Where CI pushes images (lowercase), and the image tag to run. deploy.sh sets TAG on every deploy.
IMAGE_PREFIX=ghcr.io/dadyutenga/tumaini
TAG=latest

# Loopback ports the host nginx proxies to.
API_PORT=18500
WEB_PORT=18501

# Public origin. COOKIE_SECURE must be true in production (the API refuses to start otherwise).
APP_ENV=production
CORS_ORIGINS=https://bms.qarmalab.dev
COOKIE_SECURE=true

# Generated by server-setup.sh. Hex only, so they are safe inside connection URLs.
POSTGRES_PASSWORD=
BMS_API_DB_PASSWORD=
BMS_JOBS_DB_PASSWORD=
JWT_SECRET=
MFA_ENCRYPTION_KEY=

# Backups: AES-256-CBC + PBKDF2 encryption, offsite copy and failure alert webhook. Save this whole
# file somewhere off the server: without BACKUP_ENCRYPTION_KEY and MFA_ENCRYPTION_KEY a backup is
# unreadable or incomplete. Quote values with spaces or $ in single quotes, for example
#   BACKUP_UPLOAD_CMD='rclone copy "$1" offsite:tumaini-backups/'
BACKUP_ENCRYPTION_KEY=
BACKUP_REQUIRE_ENCRYPTION=1
BACKUP_KEEP_DAYS=30
BACKUP_UPLOAD_CMD=
BACKUP_ALERT_WEBHOOK_URL=
# Hourly database dumps limit data loss to about an hour; they are kept for fewer days.
BACKUP_HOURLY_KEEP_DAYS=3
# A monitor that alerts when these stop being requested catches a backup that never ran.
BACKUP_HEARTBEAT_URL=
BACKUP_HOURLY_HEARTBEAT_URL=

# Optional virus scanning of uploads: set to clamav:3310 (needs about 3 GB of free memory).
CLAMD_ADDR=

# Optional: email and SMS (see backend/.env.example).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_WEBHOOK_URL=
SMS_API_KEY=
SMS_SENDER_ID=
